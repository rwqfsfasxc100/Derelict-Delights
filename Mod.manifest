[tags]

TAG_ADDS_EQUIPMENT={"type":"array","value":["SYSTEM_EXBIG","SYSTEM_EXSUPER","SYSTEM_SCOOP_E","SYSTEM_SCOOP_EP","SYSTEM_SCOOP_L","SYSTEM_SCOOP_LP","SYSTEM_SCOOP_M","SYSTEM_SCOOP_MP","SYSTEM_SCOOP_P"]}
TAG_ADDS_EVENTS={"type":"array","value":["More derelicts","Miners with more ships","POI_HABITAT_BUILDING","Empty Containers"]}
TAG_ADDS_GAMEPLAY_MECHANICS={"type":"array","value":["Ask containers to request a new one to be sent","Obontos ask for tungsten and beryllium","Additional trades with pirates","New Historian crew agenda"]}
TAG_ALLOW_ACHIEVEMENTS={"type":"bool","value":false}
TAG_OVERHAUL={"type":"bool","value":true}
TAG_QOL={"type":"bool","value":true}

