		"SYSTEM_EXSUPER": {
			"string": "Експериментальний Міжпланетний Контейнер",
			"version_hash": 0
		},
		"SYSTEM_EXSUPER_DESC": {
			"string": "Міжпланетний контейнер, створений за зразком успішного вантажного контейнера THI, мав стати рішенням для довготривалого зберігання, еквівалентним для постачання як тимчасових, так і постійних дослідницьких і житлових станцій в поясах і кільцях Сола, і був розрахований на вміст у 6 разів більший, ніж класичний THICC. Цей додатковий простір зробив контейнер значно важчим, що вимагало встановлення шести гоночних реактивних двигунів, а також облаштування зовнішніх баків для їх живлення. Ця збільшена маса зробила його дуже непрактичним для польотів і призвела до того, що більшість кораблів стали надто некерованими, а отже, непридатними до високої маневреності, необхідної для безпечної експлуатації в кільцях. Зараз вони використовуються виключно для міжпланетних подорожей. \\n\\nЗавдяки тому, як працює ліцензування обладнання на Енцеладі Прайм, їх все ще можна отримати, незважаючи на поблажливе ставлення до них через «Дідове положення», що дозволяє будь-якому капітану, який законно врятував судно з відповідними документами і ліцензією, мати можливість використовувати їх на будь-якому з кораблів своєї компанії.",
			"version_hash": 0
		},
		"SYSTEM_EXSUPER_MANUAL": {
			"string": "Автоматично зберігає перероблену руду.\\nВиди руди на зберіганні вибираються на вкладці «Геолог» \\nДля ефективного використання потрібна установка переробки мінералів. \\nВстановлення лише одного контейнера може порушити розважування корабля. \\nМоже бути скинутий відключенням підвісу. \\nСкинутий контейнер спробує автоматично повернутися на станцію з вантажем. \\nПорожня люлька може використовуватися для підбору дронів і рятувальних капсул.\\nЦей контейнер занадто великий для стандартних док-станцій.",
			"version_hash": 0
		},
		"DIALOG_INTERPLANETARY_WEIRD": {
			"string": "Що не так з цим контейнером? У нього дуже високотехнологічні двигуни як для контейнера, навіть якщо він і завеликий. Можливо, хтось на кшталт історика міг би дати нам краще розуміння?",
			"version_hash": 0
		},
		"AGENDA_HISTORIAN_INTERPLANETARY_IS_IT": {
			"string": "Зачекайте, хіба це не один з тих міжпланетних контейнерів? Я знав, що він виглядає занадто великим для чогось комерційного.",
			"version_hash": 0
		},
		"AGENDA_HISTORIAN_INTERPLANETARY_IT_IS": {
			"string": "Так, згідно з цим записом у базі даних, про історію вантажних контейнерів, міжпланетний контейнер є попередником міжмісячного, проте був заборонений для використання в кільцях через витрати на надійність та нестабільні зміщення маси.",
			"version_hash": 0
		},
		"AGENDA_HISTORIAN_INTERPLANETARY_WONDER": {
			"string": "Б'юся об заклад, якщо ми зможемо знайти корабель з одним із тих експериментальних контейнерів, ми могли б отримати ліцензію за дідовим положенням. Він все ще міг би бути корисним, навіть попри те, наскільки ненадійними їх вважали.",
			"version_hash": 0
		},
		"DIALOG_HABITAT_BUILDING_CONTAINER_GRANDFATHER_1": {
			"string": "Ми знайшли один з тих міжпланетних контейнерів, що просто лежав у кільцях. У нього не було транспондера, тому ми перепрограмували його як наш і відправили додому. Ми думали, що їх просто знаходять покинутими після невдалих випробувань, до того як їх заборонили.",
			"version_hash": 0
		},
		"DIALOG_HABITAT_BUILDING_CONTAINER_GRANDFATHER_2": {
			"string": "Це був один з контейнерів, які нам надіслали. Ми відставали від графіка і прийняли рішення використати їх, щоб пришвидшити доставку мінералів. Ми не думали, що втратимо так багато через піратів.",
			"version_hash": 0
		},
		"DIALOG_HABITAT_BUILDING_CONTAINER_GRANDFATHER_3": {
			"string": "Хоч контейнери і заборонені в кільцях, у нас є підрядник, якому пощастило знайти покинутий корабель зі старих випробувань. Документи на контейнери все ще були цілі, і йому дозволили використовувати їх за дідівською ліцензією. ",
			"version_hash": 0
		},
		"DIALOG_HABITAT_BUILDING_CONTAINER_GRANDFATHER_4": {
			"string": "Мало кораблів з ними взагалі випробовувалися в кільцях, тому знайти такий практично неможливо. Якщо розпитаєте навкруги, можливо, зможете знайти когось, хто щось знає про них, вони можуть допомогти більше, ніж ми.",
			"version_hash": 0
		},
		"DIALOG_ASK_ABOUT_SUPER_THICC": {
			"string": "Ми хотіли дізнатися, чи знаєте ви щось про те, що залишилося від експериментальних міжпланетних вантажних контейнерів, які випробовували в кільцях?\"",
			"version_hash": 0
		},
		"DIALOG_ASK_SORRY": {
			"string": "Вибачте, нічого від нас. Ми чули лише чутки про них.",
			"version_hash": 0
		},
		"DIALOG_ASK_HINTS": {
			"string": "Ми нічого не знаємо, але час від часу трапляються екіпажі, які намагаються знайти рідкісні чи унікальні предмети на кшталт цих. Можливо, вам пощастить більше, якщо зустрінете одного з таких капітанів.",
			"version_hash": 0
