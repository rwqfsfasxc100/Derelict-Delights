		"DIALOG_PIRATE_BUSINESS_SHIP_SNAP": {
			"string": "Получил раннюю версию строительного корабля OCP. Его дверь имеет две подвижные части, а не одну, как у современных кораблей, что делает её более центрально расположенной. В прошивке даже есть звуки из видеоигры конца XX века. 500 тысяч за корабль.",
			"version_hash": 0
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_OK720": {
			"string": "Получил очень странный проект корабля, в котором грузовой отсек OCP был приварен к корпусу одного из неудавшихся кораблей K44. Получился довольно огромный отсек. 300 тысяч за полный пакет.",
			"version_hash": 0
