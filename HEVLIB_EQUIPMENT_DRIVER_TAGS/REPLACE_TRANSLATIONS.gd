		"DIALOG_PIRATE_BUSINESS_SHIP_RAM": {
			"string": "У мене є цивільна модифікація K37, що надає декілька функцій кораблів класу Prospector. Дуже функціональна і добра для видобутку, але трохи незручна для польоту. 250 тисяч за судно.",
			"version_hash": 0
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_KTI_COTHON_MKI": {
			"string": "Знайшли один з модифікованих кораблів Котон від KTI. Досить добре тримається як гірничий корабель порівняно з іншими більш сучасними судами, тому явно має свою цінність. 250 тисяч за одиницю.",
			"version_hash": 0
		},
		"DIALOG_PIRATE_BUSINESS_SHIP_KTI_COTHON_MKII": {
			"string": "Знайшли один з модифікованих кораблів Котон від KTI. Досить добре тримається як гірничий корабель порівняно з іншими більш сучасними судами, тому явно має свою цінність. 250 тисяч за одиницю.",
